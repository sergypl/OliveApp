<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: la API de splash del sistema dibuja el logo con su
         animación de entrada; aquí se fija su duración para que sea corta y no
         alargue el arranque (ADR 0010). -->
    <style name="Theme.OlivApp" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_app</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.OlivApp.App</item>
    </style>
</resources>
